  clues:
  - clueKey: news_clay_tablet
    itemId: clay-tablet
    headline: "Hlinená tabuľka budí záujem zberateľov"
    body: "Vzácna hlinená tabuľka s klinovým písmom sa opäť dostáva do pozornosti trhu. Odborné záznamy opisujú originál ako hnedý predmet s matnou patinou. Nezvyčajne svetlý a lesklý povrch môže byť varovným znakom."
    importance: 0
  - clueKey: news_ibis
    itemId: ibis
    headline: "Mumifikovaný ibis opäť na trhu"
    body: "Mumifikovaný ibis uložený v nádobe priťahuje pozornosť milovníkov starožitností. Dochované opisy pôvodného exemplára hovoria o hnedých pásoch plátna; dokonale čisté biele obväzy vzbudzujú pochybnosti."
    importance: 0
  - clueKey: news_blue_horse
    itemId: blue-horse
    headline: "Stratený „Modrý koník“ možno našiel majiteľa"
    body: "Olejomaľba známa ako *Modrý koník* opäť rozvírila zberateľské kruhy. Archívne záznamy uvádzajú, že originál má v pravom dolnom rohu červený podpis autora. Pri posudzovaní pravosti môže rozhodnúť práve tento detail."
    importance: 0
  - clueKey: news_obsidian_blade
    itemId: obsidian-blade
    headline: "Čierna čepeľ z Tokaja"
    body: "Pri pôvodnej obsidiánovej čepeli z Tokaja môžu tenké hrany na svetle jemne presvitať. Úplne nepriehľadná čepeľ si zaslúži pozornejšie preskúmanie."
    importance: 1
  - clueKey: news_bronze_statue
    itemId: bronze-statue
    headline: "Čo prezrádza patina bronzovej sochy?"
    body: "Známa bronzová socha má podľa odborných záznamov zelenú patinu. Hnedý, umelo nanesený povrch nezodpovedá opisu pôvodného kusu."
    importance: 1
  - clueKey: news_glass_vase
    itemId: glass-vase
    headline: "Modrý poklad historickej sklárne"
    body: "Zberatelia pátrajú po sklenenej váze s podpisom firmy. Pôvodný variant je podľa katalógu modrý. Zelená verzia sa od opisu originálu odlišuje."
    importance: 1
